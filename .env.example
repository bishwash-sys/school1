# Copy this file to ".env" and fill in your own values.
# The eSewa values below are PUBLIC TEST credentials published by eSewa for developers —
# safe to use as-is for testing, but must be replaced before accepting real money.

# Your site's public URL (used to build payment return links).
# Use http://localhost:3000 for local testing; your real domain once deployed.
SITE_URL=http://localhost:3000

# ---------------- eSewa (sandbox defaults shown) ----------------
ESEWA_GATEWAY_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# ---------------- Khalti ----------------
# Get your own sandbox secret key free at https://test-admin.khalti.com
KHALTI_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_SECRET_KEY=

# ---------------- Stripe (cards) ----------------
# Get a free test secret key at https://dashboard.stripe.com (starts with sk_test_...)
STRIPE_SECRET_KEY=
